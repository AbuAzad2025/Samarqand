# Copy to .env for local development, or to the server's untracked shared/.env.
# NEVER commit real values: SECRET_KEY and all passwords live only there.
# An empty value means "disabled / use the safe default".

# --- Settings module -------------------------------------------------------
# Local development / tests. The server uses contracting_site.settings.prod
# (see the commented production block at the bottom of this file).
DJANGO_SETTINGS_MODULE=contracting_site.settings.dev
# Informational only: DEBUG is fixed by the selected settings module
# (True in dev, False in prod); setting it here has no effect.
DEBUG=

# --- Django core -----------------------------------------------------------
# Generated automatically in dev when empty. Required (no default) in prod.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000

# --- Database --------------------------------------------------------------
# Empty DB_ENGINE uses db.sqlite3 in the project root (local development).
# In prod, DB_PASSWORD is required when DB_ENGINE=postgres; it is read only
# from this untracked file / the process environment, never from code.
DB_ENGINE=
DB_NAME=contracting_site
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# docker-compose.yml uses POSTGRES_PASSWORD for the container and maps it to
# DB_PASSWORD; it is required by compose and intentionally empty here.
POSTGRES_PASSWORD=

# --- Bootstrap commands (local only) ---------------------------------------
# Required by seed_demo_users; never use demo accounts outside development.
DEMO_USERS_PASSWORD=
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Optional AI / analytics ------------------------------------------------
# Both are OPTIONAL and are intentionally EMPTY at present: no AI feature is
# advertised as active and no analytics tag is emitted until real values are
# provided by the operator.
GEMINI_API_KEY=
GA_MEASUREMENT_ID=

# --- Email (SMTP; console backend when EMAIL_HOST is empty) ----------------
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# --- IMAP inbox sync (optional) --------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Runtime tuning --------------------------------------------------------
TRUSTED_PROXY_IPS=
ADMIN_API_RATE_LIMIT=600
ANNUAL_LEAVE_DAYS=21
TIME_CLOCK_IMPORT_DIR=
SERVE_MEDIA=false
AUTO_MIGRATE=false
AUTO_MIGRATE_LOCK_PATH=/srv/apps/samarqand/shared/run/samarqand_migrate.lock

# --- Production security ---------------------------------------------------
# Secure defaults live in settings/prod.py; these entries document the
# supported overrides. Do not lower them without an explicit decision.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_REFERRER_POLICY=same-origin
# nginx terminates TLS: set TRUST_X_FORWARDED_PROTO=true on the server or
# SECURE_SSL_REDIRECT will loop. Keep false for any directly exposed app.
TRUST_X_FORWARDED_PROTO=false
USE_X_FORWARDED_HOST=false
RENDER_EXTERNAL_HOSTNAME=
# Cookie note: CSRF_COOKIE_HTTPONLY must stay False — the SPA reads the
# csrftoken cookie in JavaScript. Content-Security-Policy is emitted by nginx
# (Django core has no CSP setting) and must allow /static/ SPA assets and the
# Wagtail admin scripts.

# --- Static / media / cache (server uses the shared/ dirs) -----------------
# Leave these UNSET locally so the project defaults (<project>/static,
# <project>/media, <project>/cache) apply — an empty value is not the same
# thing. On the server, set them to shared/ paths in the untracked .env.
# Purge the cache in place: find "$CACHE_LOCATION" -mindepth 1 -delete
# STATIC_ROOT=/srv/apps/samarqand/shared/static
# MEDIA_ROOT=/srv/apps/samarqand/shared/uploads
# CACHE_LOCATION=/srv/apps/samarqand/shared/cache

# --- Gunicorn ---------------------------------------------------------------
# Default is this app's private Unix socket (no TCP port conflict). Docker
# sets GUNICORN_BIND=0.0.0.0:8000 explicitly; leave it unset on the server.
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_SOCKET=/srv/apps/samarqand/shared/run/samarqand.sock
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_ACCESSLOG=-
GUNICORN_ERRORLOG=-
GUNICORN_LOGLEVEL=info

# --- Frontend build --------------------------------------------------------
VITE_API_BASE_URL=

# --- Production example (uncomment on the SERVER only; no real secrets) ----
# DJANGO_SETTINGS_MODULE=contracting_site.settings.prod
# SECRET_KEY=<generated on the server, never committed>
# ALLOWED_HOSTS=samarqand.azadexa.com
# CSRF_TRUSTED_ORIGINS=https://samarqand.azadexa.com
# WAGTAILADMIN_BASE_URL=https://samarqand.azadexa.com
# DB_ENGINE=postgresql
# DB_NAME=samarqand_db
# DB_USER=samarqand_user
# DB_PASSWORD=<from the server's untracked .env>
# DB_HOST=127.0.0.1
# DB_PORT=5432
# TRUST_X_FORWARDED_PROTO=true
# USE_X_FORWARDED_HOST=true
# SERVE_MEDIA=false
# AUTO_MIGRATE=false
# STATIC_ROOT=/srv/apps/samarqand/shared/static
# MEDIA_ROOT=/srv/apps/samarqand/shared/uploads
# CACHE_LOCATION=/srv/apps/samarqand/shared/cache
