# Local development configuration (SQLite by default — no database server required)
DJANGO_SETTINGS_MODULE=contracting_site.settings.dev

# In dev this is generated automatically when left empty.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Database: leave DB_ENGINE empty to use db.sqlite3 in the project root.
# Set to "postgres" only if you deliberately want a PostgreSQL server.
DB_ENGINE=
DB_NAME=contracting_site
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Required by: python manage.py seed_demo_users (no default password exists).
# Never use demo accounts outside local development.
DEMO_USERS_PASSWORD=
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Optional AI features (disabled when the key is empty)
GEMINI_API_KEY=

# Optional SMTP (console backend is used when EMAIL_HOST is empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Optional IMAP inbox sync
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# docker-compose.yml expects POSTGRES_PASSWORD (not DB_PASSWORD).
POSTGRES_PASSWORD=

# Runtime tuning
EMAIL_TIMEOUT=20
TRUSTED_PROXY_IPS=
TRUST_X_FORWARDED_PROTO=false
ADMIN_API_RATE_LIMIT=600
ANNUAL_LEAVE_DAYS=21
TIME_CLOCK_IMPORT_DIR=
SERVE_MEDIA=false
AUTO_MIGRATE=false

# Production security / email / proxy
EMAIL_BACKEND=
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
USE_X_FORWARDED_HOST=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_REFERRER_POLICY=same-origin
RENDER_EXTERNAL_HOSTNAME=
AUTO_MIGRATE_LOCK_PATH=/tmp/django_migrate.lock

# Gunicorn
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_ACCESSLOG=-
GUNICORN_ERRORLOG=-
GUNICORN_LOGLEVEL=info

# Frontend build (bake at build time)
VITE_API_BASE_URL=

# Analytics (leave empty to disable GA4 entirely)
GA_MEASUREMENT_ID=

# --- Production (server only; never commit real values) ---
DB_ENGINE=postgresql
DB_NAME=samarqand_db
DB_USER=samarqand_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
ALLOWED_HOSTS=samarqand.azadexa.com
CSRF_TRUSTED_ORIGINS=https://samarqand.azadexa.com
TRUST_X_FORWARDED_PROTO=true
USE_X_FORWARDED_HOST=true
STATIC_ROOT=/srv/apps/samarqand/shared/static
MEDIA_ROOT=/srv/apps/samarqand/shared/uploads
CACHE_LOCATION=/srv/apps/samarqand/shared/cache
AUTO_MIGRATE=false
